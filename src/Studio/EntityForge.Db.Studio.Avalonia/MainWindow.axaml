<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workspace="using:EntityForge.UI.Avalonia.Workspace"
        x:Class="EntityForge.Db.Studio.Avalonia.StudioView"
        Background="{DynamicResource EntityForge.Brush.Canvas}">
  <Grid x:Name="StudioRoot" ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,*">
    <Border Grid.RowSpan="3" Classes="ef-rail" Padding="12,14">
      <Grid RowDefinitions="Auto,*,Auto">
        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                Click="OpenEntityForgeWebsite" ToolTip.Tip="Visit entityforge.io">
          <Image Width="36" Height="36"
                 Source="avares://EntityForge.UI.Avalonia/Assets/Brand/entity-forge-mark-128.png" />
        </Button>
        <StackPanel Grid.Row="2" Spacing="8">
          <Button Classes="ef-rail-command" Content="?" Click="OpenAbout" ToolTip.Tip="About EntityForge DB Studio" />
          <Button x:Name="SettingsButton" Classes="ef-rail-command" Click="OpenSettings"
                  AutomationProperties.Name="Settings" ToolTip.Tip="Settings">
            <PathIcon Width="20" Height="20"
                      Data="M 9,2 L 15,2 15.5,5 17,6 20,5 23,10 20.5,12 20.5,14 23,16 20,21 17,20 15.5,21 15,24 9,24 8.5,21 7,20 4,21 1,16 3.5,14 3.5,12 1,10 4,5 7,6 8.5,5 Z M 12,9 A 4,4 0 1 0 12,17 A 4,4 0 1 0 12,9 Z" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Padding="18,12" BorderBrush="{DynamicResource EntityForge.Brush.Border}"
            BorderThickness="0,0,0,1" Background="{DynamicResource EntityForge.Brush.Canvas}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
          <Border Classes="ef-badge" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <Ellipse x:Name="ConnectionLed" Width="7" Height="7" Fill="{DynamicResource EntityForge.Brush.Warning}" />
              <TextBlock Grid.Column="1" x:Name="ConnectionStatus" Text="Not connected" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="ConnectButton" Classes="ef-primary" Content="Connect" Click="Connect" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource EntityForge.Brush.Canvas}"
            BorderBrush="{DynamicResource EntityForge.Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,5">
          <Button Classes="ef-command" Content="Layout" AutomationProperties.Name="Layout options"
                  ToolTip.Tip="Customize tabs and panel layout">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Add Tab" Click="AddTab" />
                <MenuItem x:Name="EditLayoutMenuItem" Header="Edit Layout" Click="ToggleEdit" />
                <Separator />
                <MenuItem Header="Reset Layout" Click="ResetLayout" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
      <Border x:Name="PersistenceNotice" IsVisible="False" Classes="ef-card" Margin="16,8,16,0" Padding="10">
        <WrapPanel Orientation="Horizontal">
          <TextBlock x:Name="PersistenceMessage" TextWrapping="Wrap" MaxWidth="480" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button x:Name="RetryPersistenceButton" Content="Retry save" Click="RetryPersistence" Margin="0,0,8,0" />
          <Button x:Name="ReplaceLayoutButton" Content="Replace saved layout" Click="ReplaceUnreadableLayout"
                  ToolTip.Tip="Overwrite the unreadable saved layout with the current layout" IsVisible="False" />
        </WrapPanel>
      </Border>
      <Border x:Name="ConnectionNotice" Grid.Row="1" IsVisible="False" Classes="ef-card" Margin="16,8,16,0" Padding="10">
        <WrapPanel ItemSpacing="12" LineSpacing="8">
          <TextBlock x:Name="ConnectionNoticeText" TextWrapping="Wrap" MaxWidth="620" VerticalAlignment="Center" />
            <Button x:Name="RetryConnectionButton" Content="Check now" Click="RetryConnection" />
          <Button x:Name="DismissConnectionNoticeButton" Content="Dismiss" Click="DismissConnectionNotice" IsVisible="False" />
        </WrapPanel>
      </Border>
      <Border x:Name="EditBar" Grid.Row="2" IsVisible="False" Margin="16,12,16,0" Padding="10"
              Classes="ef-card" Background="{DynamicResource EntityForge.Brush.SurfaceRaised}">
        <Grid ColumnDefinitions="Auto,240,Auto,*,Auto,Auto">
          <TextBlock VerticalAlignment="Center" Text="Tab name" Margin="0,0,8,0" />
          <TextBox x:Name="TabName" Grid.Column="1" />
          <Button Grid.Column="2" Classes="ef-command" Content="Apply" Margin="6,0,0,0" Click="RenameTab" />
          <TextBlock Grid.Column="3" Classes="ef-muted" VerticalAlignment="Center" Margin="16,0"
                     Text="Drag highlighted splitters; split, change or remove modules from each panel." />
          <Button Grid.Column="4" Classes="ef-command" Content="Remove Tab" Click="RemoveTab" />
          <Button Grid.Column="5" Classes="ef-primary" Content="Finish Layout" Margin="8,0,0,0" Click="ToggleEdit" />
        </Grid>
      </Border>
      <workspace:AdaptiveWorkspaceControl x:Name="Workspace" Grid.Row="3" Margin="16"
                                          WideBreakpoint="960" FocusBreakpoint="600" IsVisible="False" />
      <Border x:Name="WelcomePanel" Grid.Row="3" Classes="ef-card" Margin="16" Padding="24"
              MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Classes="ef-title" Text="Explore your database" TextWrapping="Wrap" />
          <TextBlock Text="Connect to browse your data, build a query and inspect its results and sources." TextWrapping="Wrap" />
          <TextBlock Classes="ef-muted" Text="You will need your server address and an access token from your database administrator. Your saved layout is kept when you disconnect." TextWrapping="Wrap" />
          <Button Content="Connect to a database" Classes="ef-primary" HorizontalAlignment="Left" Click="Connect" />
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="ModalOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="False"
            Background="{DynamicResource EntityForge.Brush.Overlay}" ZIndex="100">
      <ScrollViewer Margin="16" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Padding="20" Classes="ef-card raised" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="10">
          <TextBlock Classes="ef-title" Text="Connect to a database" />
          <TextBlock Classes="ef-muted" Text="Enter the database server address and a token supplied by its administrator." TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ComboBox x:Name="SavedConnections" HorizontalAlignment="Stretch" SelectionChanged="SelectSavedConnection" PlaceholderText="Saved Connections" />
            <Button Grid.Column="1" Content="New" Click="NewConnectionProfile" />
            <Button Grid.Column="2" x:Name="RemoveConnectionButton" Content="Remove" Click="RemoveConnectionProfile" IsEnabled="False" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Connection Name" />
            <TextBox Grid.Column="1" x:Name="ConnectionNameInput" AutomationProperties.Name="Connection name" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Host Address" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ConnectionEndpointInput" AutomationProperties.Name="Host address" />
          </Grid>
          <Button Content="Save name and address" Click="SaveConnectionProfile" HorizontalAlignment="Right" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Bearer Token" />
            <TextBox Grid.Column="1" x:Name="ConnectionTokenInput" PasswordChar="●" PlaceholderText="Enter Token" AutomationProperties.Name="Bearer token" />
          </Grid>
          <CheckBox x:Name="RememberConnectionInput" IsChecked="True"
                    Content="Remember This Name And Address" />
          <TextBlock Classes="ef-muted" Text="Your token is used for this connection only and is never saved in the connection profile." TextWrapping="Wrap" />
          <TextBlock x:Name="ConnectionInputError" Classes="ef-warning" IsVisible="False"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="ef-command" Content="Cancel" Click="CancelConnectionOverlay" />
            <Button Classes="ef-primary" Content="Connect" IsDefault="True" Click="AcceptConnectionOverlay" />
          </StackPanel>
        </StackPanel>
      </Border>
      </ScrollViewer>
    </Border>
    <Border x:Name="SettingsOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="False"
            Background="{DynamicResource EntityForge.Brush.Overlay}" ZIndex="200"
            KeyDown="SettingsOverlayKeyDown">
      <ScrollViewer Margin="24" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Classes="ef-card raised" Padding="24" KeyboardNavigation.TabNavigation="Cycle">
          <StackPanel Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock Classes="ef-title" Text="Settings" />
              <TextBlock Classes="ef-muted" Text="Personalize Studio on this device." TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="12">
              <TextBlock Text="Appearance" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox x:Name="SettingsTheme" Grid.Column="1" MinWidth="160"
                          AutomationProperties.Name="Theme" SelectionChanged="SelectSettingsTheme" />
              </Grid>
            </StackPanel>
            <TextBlock x:Name="SettingsError" Classes="ef-warning" IsVisible="False" TextWrapping="Wrap" />
            <Button Classes="ef-primary" Content="Done" HorizontalAlignment="Right" Click="CloseSettingsClick" />
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
    <Border x:Name="AboutOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="False"
            Background="{DynamicResource EntityForge.Brush.Overlay}" ZIndex="200"
            KeyDown="AboutOverlayKeyDown">
      <ScrollViewer Margin="24" MaxWidth="600" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="AboutContent" HorizontalContentAlignment="Stretch" />
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
