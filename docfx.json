  "build": {
    "content": [
      {
        "files": [
          "README.md",
          "CHANGELOG.md",
          "SECURITY.md",
          "CONTRIBUTING.md",
          "CODE_OF_CONDUCT.md",
          "index.md",
          "LICENSING.md",
          "THIRD-PARTY-NOTICES.md",
          "toc.yml",
          "docs/**/*.md",
          "docs/db/*.md",
          "src/Shared/**/*.md"
        ]
      },
      {
        "files": [
          "**/*.yml"
        ],
        "src": "artifacts/docs/api",
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": [
          "License.md",
          "Version.props",
          ".editorconfig",
          ".gitattributes",
          "docs/images/**",
          "src/Shared/EntityForge.UI.Avalonia/Assets/Brand/entity-forge-mark-128.png",
          "docs/db/LICENSE",
          "docs/db/NOTICE",
          "src/Db/EntityForge.Db.Query.Syntax/Gql/NOTICE.txt",
          "src/Db/EntityForge.Db.Query.Syntax/Gql/LICENSE.txt",
          "docs/db/*.graphql"
        ]
      }
    ],
    "dest": "artifacts/docs/site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "EntityForge",
      "_appTitle": "EntityForge DB and Studio",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "sitemap": {},
    "disableGitFeatures": true
  }
